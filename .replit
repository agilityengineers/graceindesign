modules = ["nodejs-20", "web", "postgresql-16", "python-base-3.13"]
run = "npm run dev"
hidden = [".config", ".git", "node_modules", ".next", "design/screenshots"]

[nix]
channel = "stable-25_05"

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "npm ci --include=dev && npm run build"]
run = ["npm", "run", "start"]

[[ports]]
localPort = 5000
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run db:setup -- --if-empty && npm run dev"
waitForPort = 5000

[userenv]

[userenv.shared]
NEXT_TELEMETRY_DISABLED = "1"

[userenv.production]
NODE_ENV = "production"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000
