# Grace In Design — environment variables
# Copy to `.env` for local development. On Replit, set these as Secrets
# (Tools → Secrets). Replit's built-in PostgreSQL provides DATABASE_URL
# automatically in both the workspace and the published deployment.

# ---------------------------------------------------------------------------
# Core (required)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://gid:gid@127.0.0.1:5432/graceindesign
# Public base URL (used in emails, .ics, webhooks, SSO). Replit sets REPLIT_DEV_DOMAIN /
# REPLIT_DOMAINS automatically. Development uses REPLIT_DEV_DOMAIN first so forks
# stay isolated. Production (and local development) uses BASE_URL when set.
BASE_URL=http://localhost:5000
# 48+ random bytes, hex. Signs session cookies, magic links and encrypts stored tokens.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-in-production-change-me-in-production
NODE_ENV=development

# ---------------------------------------------------------------------------
# Email (SendGrid) — lead/booking notifications, magic links, moderation emails
# Without a key, every email is recorded in the `outbox` table and logged.
# ---------------------------------------------------------------------------
SENDGRID_API_KEY=
EMAIL_FROM="Grace In Design <support@graceindesign.net>"
ADMIN_NOTIFY_EMAIL=support@graceindesign.net

# ---------------------------------------------------------------------------
# SMS (Twilio) — booking confirmations, reminders, follow-up templates
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ---------------------------------------------------------------------------
# Cron (Replit Scheduled Deployments call /api/cron/<job> with this bearer token,
# or run `npm run cron -- <job>` directly in the same environment)
# ---------------------------------------------------------------------------
CRON_SECRET=change-me

# ---------------------------------------------------------------------------
# Call Flow Tracker integration (future; safe to leave blank)
# ---------------------------------------------------------------------------
# Shared secret CFT signs outbound webhooks with (X-CallFlow-Signature). Set the same
# value on the CFT subscription that points at <BASE_URL>/api/webhooks/cft
CFT_WEBHOOK_SECRET=
# Connected Apps SSO (CFT is the issuer). CFT_URL is the CFT base URL; CFT_SSO_SECRET is
# the secret shown once when this app is registered under CFT → Administration →
# Connected Apps (launch URL: <BASE_URL>/api/sso/launch). CFT_SSO_APP_ID is the audience
# this app announces — keep the default unless you re-register.
CFT_URL=
CFT_SSO_SECRET=
CFT_SSO_SECRET_PREVIOUS=
CFT_SSO_APP_ID=5f1d4a8e-8c3b-4b7e-9c2a-7f3a0d6e1b42

# ---------------------------------------------------------------------------
# Media storage — Replit Object Storage when REPLIT_OBJECT_STORAGE_BUCKET is set
# (or running inside Replit with a default bucket); otherwise files are stored under
# ./.data/uploads for local development.
# ---------------------------------------------------------------------------
REPLIT_OBJECT_STORAGE_BUCKET=
# Optional: Magnific / Freepik API key for "Generate with Magnific" in the media library
MAGNIFIC_API_KEY=

# ---------------------------------------------------------------------------
# Phase 2: content sync
# ---------------------------------------------------------------------------
ETSY_SHOP_URL=https://www.etsy.com/shop/GraceInDesign
ETSY_API_KEY=

# ---------------------------------------------------------------------------
# Phase 3: social publishing (OAuth apps). Leave blank until the accounts are ready.
# ---------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Phase 4: payments, e-sign, CRM
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DROPBOX_SIGN_API_KEY=
HUBSPOT_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Seeding
# ---------------------------------------------------------------------------
# Comma-separated owner emails created on first seed (magic-link login).
SEED_OWNER_EMAILS=info@graceindesign.net,emailme@clarencewilliams.com
SEED_SUPER_ADMIN_EMAIL=emailme@clarencewilliams.com
