# Grace In Design — environment variables
# Copy to `.env` for local development. On Replit, set these as Secrets
# (Tools → Secrets). Replit's built-in PostgreSQL provides DATABASE_URL
# automatically in both the workspace and the published deployment.

# ---------------------------------------------------------------------------
# Core (required)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://gid:gid@127.0.0.1:5432/graceindesign
# Public base URL (used in emails, .ics, webhooks, SSO). Replit sets REPLIT_DEV_DOMAIN /
# REPLIT_DOMAINS automatically. Development uses REPLIT_DEV_DOMAIN first so forks
# stay isolated. Production (and local development) uses BASE_URL when set.
BASE_URL=http://localhost:5000
# 48+ random bytes, hex. Signs session cookies, magic links and encrypts stored tokens.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-in-production-change-me-in-production
NODE_ENV=development

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave blank to load no analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Email (SendGrid) — lead/booking notifications, magic links, moderation emails
# Without a key, every email is recorded in the `outbox` table and logged.
# The four senders below are the addresses verified in SendGrid. Defaults are already correct for
# graceindesign.net; set them only to change the display name or address.
#   noreply@      sign-in links, receipts, internal notices — nothing to reply to
#   support@      general questions: directory/event submissions, portal, invoices, moderation
#   consultation@ anything sales-related: consultation requests, bookings, reminders, proposals, drips
#   newsletter@   newsletter welcomes, checklist downloads, newsletter issues
# ---------------------------------------------------------------------------
SENDGRID_API_KEY=
EMAIL_FROM_NOREPLY="Grace In Design <noreply@graceindesign.net>"
EMAIL_FROM_SUPPORT="Grace In Design <support@graceindesign.net>"
EMAIL_FROM_CONSULTATION="Grace In Design <consultation@graceindesign.net>"
EMAIL_FROM_NEWSLETTER="Grace In Design <newsletter@graceindesign.net>"
# Legacy single sender (older deployments); now only a fallback for EMAIL_FROM_SUPPORT.
EMAIL_FROM=
# Inboxes for team notifications (the admin's Form builder → Notifications card can override these).
ADMIN_NOTIFY_EMAIL=support@graceindesign.net
SALES_NOTIFY_EMAIL=consultation@graceindesign.net
# Grace's mobile for new-lead texts (E.164). The admin setting overrides this.
ADMIN_NOTIFY_PHONE=

# ---------------------------------------------------------------------------
# Slack — one Incoming Webhook URL (Slack → Apps → Incoming Webhooks → pick the channel).
# New consultation requests, directory/event submissions, newsletter sign-ups and Call Flow Tracker
# call events are posted there. Keep that channel private: posts can carry Grace's auto sign-in link.
# ---------------------------------------------------------------------------
SLACK_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# SMS (direct Twilio) — only used when Call Flow Tracker SMS (below) is not configured.
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ---------------------------------------------------------------------------
# Cron (Replit Scheduled Deployments call /api/cron/<job> with this bearer token,
# or run `npm run cron -- <job>` directly in the same environment)
# ---------------------------------------------------------------------------
CRON_SECRET=change-me

# ---------------------------------------------------------------------------
# Call Flow Tracker (CFT). See docs/replit-notifications-setup.md for the step-by-step.
# ---------------------------------------------------------------------------
# CFT base URL, e.g. https://callflowtracker.yourdomain.com (no trailing slash).
CFT_URL=
# --- GID → CFT: sign Grace in automatically + send texts through CFT's Twilio ---
# Same value as CFT's own MASTER_DASHBOARD_SECRET (CFT accepts master-dashboard SSO tokens at
# /sso/launch). With it set, the texted/Slacked link signs her straight into CFT, and texts go out
# through CFT's Twilio connection. Without it, links open CFT's login page and texts use TWILIO_*.
CFT_MASTER_DASHBOARD_SECRET=
# CFT's master app id — fixed in CFT (shared/masterDashboardConfig.ts). Leave as is.
CFT_MASTER_APP_ID=608c99a8-0a2b-41d7-8930-f2dc3b0fe964
# Tracking number in CFT (E.164) that team texts are sent FROM. Must be SMS-capable and usable by
# the sending user (see CFT_SMS_SENDER_EMAIL).
CFT_SMS_FROM=
# CFT login email of the user whose CFT session sends those texts. Defaults to the notification
# user set in Admin → Form builder → Notifications (Grace). Must be an active CFT user.
CFT_SMS_SENDER_EMAIL=
# How long a texted auto sign-in link stays valid, in hours (default 24).
CFT_LAUNCH_LINK_HOURS=24
# --- CFT → GID: call events + sign-in from CFT's Connected Apps ---
# Shared secret CFT signs outbound webhooks with (X-CallFlow-Signature). Set the same
# value on the CFT subscription that points at <BASE_URL>/api/webhooks/cft
CFT_WEBHOOK_SECRET=
# Connected Apps SSO (CFT is the issuer). CFT_SSO_SECRET is the secret shown once when this app is
# registered under CFT → Administration → Connected Apps (launch URL: <BASE_URL>/api/sso/launch).
# CFT_SSO_APP_ID is the audience this app announces — keep the default unless you re-register.
CFT_SSO_SECRET=
CFT_SSO_SECRET_PREVIOUS=
CFT_SSO_APP_ID=5f1d4a8e-8c3b-4b7e-9c2a-7f3a0d6e1b42

# ---------------------------------------------------------------------------
# Media storage — Replit Object Storage when REPLIT_OBJECT_STORAGE_BUCKET is set
# (or running inside Replit with a default bucket); otherwise files are stored under
# ./.data/uploads for local development.
# ---------------------------------------------------------------------------
REPLIT_OBJECT_STORAGE_BUCKET=
# Optional: Magnific / Freepik API key for "Generate with Magnific" in the media library
MAGNIFIC_API_KEY=

# ---------------------------------------------------------------------------
# Phase 2: content sync
# ---------------------------------------------------------------------------
ETSY_SHOP_URL=https://www.etsy.com/shop/GraceInDesign
ETSY_API_KEY=

# ---------------------------------------------------------------------------
# Phase 3: social publishing (OAuth apps). Leave blank until the accounts are ready.
# ---------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Phase 4: payments, e-sign, CRM
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DROPBOX_SIGN_API_KEY=
HUBSPOT_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Seeding
# ---------------------------------------------------------------------------
# Comma-separated owner emails created on first seed (magic-link login).
SEED_OWNER_EMAILS=info@graceindesign.net,emailme@clarencewilliams.com
SEED_SUPER_ADMIN_EMAIL=emailme@clarencewilliams.com
