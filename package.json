{
  "name": "graceindesign",
  "version": "0.1.0",
  "private": true,
  "description": "Grace In Design Services, LLC — public site, consultation funnel, admin/CMS, project pipeline, social and client ops.",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "node scripts/next-safe.mjs dev -p 5000 -H 0.0.0.0",
    "build": "next build",
    "start": "node scripts/next-safe.mjs start -p ${PORT:-5000} -H 0.0.0.0",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts",
    "db:setup": "npm run db:migrate && npm run db:seed --",
    "content:launch": "tsx scripts/launch-content.ts",
    "cron": "tsx scripts/cron.ts",
    "media:fetch": "tsx scripts/fetch-media.ts",
    "test": "playwright test",
    "test:log-redaction": "node --test tests/log-redaction.test.mjs",
    "test:outbox-privacy": "tsx --test tests/outbox-privacy.test.ts",
    "test:auth-logging": "node tests/auth-logging-smoke.mjs",
    "test:magic-link-concurrency": "node tests/magic-link-concurrency.mjs",
    "test:dev-link-store": "tsx --test tests/dev-link-store.test.ts",
    "test:launch-content": "node tests/launch-content.mjs",
    "test:notifications": "tsx --test tests/email-senders.test.ts tests/cft-launch-token.test.ts tests/slack-payload.test.ts tests/cft-sms-contract.test.ts",
    "verify": "npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "@replit/object-storage": "^1.0.0",
    "@sendgrid/mail": "^8.1.6",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.2.5",
    "nanoid": "^5.1.5",
    "next": "15.5.27",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "stripe": "^17.7.0",
    "twilio": "^5.10.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
